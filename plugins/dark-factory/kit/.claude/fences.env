# Fence level of this project, read by the dark-factory plugin (guard, quota guard) and scripts/merge-feature.sh.
# The file also opts the project in: without it the plugin's guards stay silent.
#
#   solo      the guard denies only destructive things: force push, a push to the main branch,
#             --no-verify/hooks bypass, release-tag pushes, deleting or hard-resetting the main branch;
#             merge-feature.sh needs --accepted-by; --skip-ci allowed
#   standard  solo + `gh pr merge` only via merge-feature.sh, no agent approvals,
#             the fence files (.claude/settings*.json, this file, .githooks/, scripts/merge-feature.sh)
#             are edited only with the human's yes in the permission dialog
#   team      standard + a GitHub approval before merging; --skip-ci refused
#
# At every level deleting, moving or truncating this file and lowering FENCE_LEVEL by an edit need the human's yes
# in the permission dialog (denied to subagents and unattended sessions); the usual way is /dark-factory:level.
# Human override of all fences: restart the session with GUARD=off (quota: QUOTA_GUARD=off).
FENCE_LEVEL=solo

# 1 = no quota data counts as "no new work" instead of letting work through (unattended sessions).
QUOTA_FAIL_CLOSED=0
