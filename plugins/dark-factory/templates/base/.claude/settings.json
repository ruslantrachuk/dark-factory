{
  "extraKnownMarketplaces": {
    "dark-factory": {
      "source": {
        "source": "github",
        "repo": "ruslantrachuk/dark-factory",
        "ref": "v24"
      }
    }
  },
  "enabledPlugins": {
    "dark-factory@dark-factory": true
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/channels/**)",
      "Read(./.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/fences.env)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/merge-feature.sh)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/Library/Keychains",
        "~/.claude/.credentials.json",
        "~/.claude/channels"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "objects.githubusercontent.com",
        "*.githubusercontent.com",
        "<stack domains: pypi.org, files.pythonhosted.org / registry.npmjs.org …>",
        "<project domains: API, deploy, tracker>"
      ]
    },
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent/session-start.sh\" claude"
          }
        ]
      }
    ]
  }
}
