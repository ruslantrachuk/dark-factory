# Base template .gitignore. deploy-base.sh never overwrites a project's own .gitignore —
# a project that keeps its own merges these lines into it by hand.

# Claude Code: local secrets and settings, run worktrees (CLAUDE.md)
.claude/env
.claude/settings.local.json
.claude/worktrees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Environment files with secrets; the example is committed
.env
.env.*
!.env.example

# The execution queue (beads): one local store per checkout, outside git; only its README is tracked
# (.beads/README.md). Worktrees use the main checkout's store.
.beads/*
!.beads/README.md

# .harness/ is committed (base-sha, modules.md, pyramid-baseline.json — .harness/README.md): do not add it here.

# this server's settings for the project: session.env, analytics.env, stands.json (dev stands: ports, tunnels,
# addresses) — they describe the server, not the project
.claude/factory/

# dark-factory guard: local audit log of denials (.claude/state/audit.jsonl)
.claude/state/
