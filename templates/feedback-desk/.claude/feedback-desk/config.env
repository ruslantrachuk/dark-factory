# On-call agent for the Telegram feedback group: a separate persistent Claude Code session with the official
# plugin:telegram channel (Claude Code Channels). It reads the group and replies to it; other
# sessions write to the group via SendMessage to the On-call agent. Started by scripts/feedback-desk.sh,
# configured by the feedback-desk skill. Any value can be overridden by an environment variable.

# Session name: ListAgents/SendMessage (and Remote Control) see it under this name.
DESK_NAME="${DESK_NAME:-On-call <project>}"
# tmux session of the On-call agent.
DESK_TMUX="${DESK_TMUX:-<pfx>-feedback}"
# Directory the session starts from: the project's main checkout (memory, devlog, skills are there).
DESK_WORKDIR="${DESK_WORKDIR:-<abs path to the main checkout>}"
# On-call model — as a full id (the sonnet alias silently gives Sonnet 5). Triage and short replies.
DESK_MODEL="${DESK_MODEL:-claude-sonnet-5-5}"
# Remote Control: the session is visible and can be driven from claude.ai and the mobile app.
DESK_REMOTE="${DESK_REMOTE:-true}"
# Default development session — the On-call agent forwards requests to it if nobody
# told it "forward to me". The name as in ListAgents.
DESK_DEV_SESSION="${DESK_DEV_SESSION:-<dev session name>}"

# Channel and bot. Plugin state (token, access.json, inbox) is separate per project:
# by default the plugin keeps one state per machine, and two projects would share the bot.
DESK_PLUGIN="${DESK_PLUGIN:-telegram@claude-plugins-official}"
DESK_STATE_DIR="${DESK_STATE_DIR:-$HOME/.claude/channels/telegram-<pfx>}"

# Group: id (negative for supergroups, with the -100 prefix), react without a bot mention
# (false requires disabling the bot's privacy mode in @BotFather), who can wake the session
# (numeric ids, comma-separated; empty — all group members).
DESK_GROUP_ID="${DESK_GROUP_ID:-<group id>}"
DESK_REQUIRE_MENTION="${DESK_REQUIRE_MENTION:-false}"
DESK_GROUP_ALLOW="${DESK_GROUP_ALLOW:-}"
# DMs: pairing — the owner pairs and receives the On-call permission requests there;
# after pairing it can be switched to allowlist (do not answer strangers with a code).
DESK_DM_POLICY="${DESK_DM_POLICY:-pairing}"

# Prod monitor channel (module prod-monitor): mcp.json is written by `prod-monitor.sh install`.
# No file — the On-call agent runs without the monitor channel.
DESK_MONITOR_MCP="${DESK_MONITOR_MCP:-$HOME/<pfx>-monitor/prod_monitor/channel/mcp.json}"
