{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/channels/**)",
      "Read(<project secrets dir, e.g. ~/.config/<project>/**>)",
      "Read(./.env*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/fences.env)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/guard.py)",
      "Edit(./scripts/quota.py)",
      "Edit(./scripts/merge-feature.sh)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/Library/Keychains",
        "~/.claude/.credentials.json",
        "~/.claude/channels",
        "<project secrets dir, e.g. ~/.config/<project>>"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "objects.githubusercontent.com",
        "*.githubusercontent.com",
        "<stack domains: pypi.org, files.pythonhosted.org / registry.npmjs.org …>",
        "<project domains: API, deploy, tracker>"
      ]
    },
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ensure-git-hooks.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/env-context.sh\"",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" session-start",
            "type": "command",
            "timeout": 120
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" prompt",
            "type": "command",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard.py\"",
            "type": "command",
            "timeout": 30
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" pretool",
            "type": "command",
            "timeout": 120
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" posttool",
            "type": "command",
            "timeout": 120
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" subagent-start",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/quota.py\" subagent-stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
