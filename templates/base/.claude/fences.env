# Fence level of this project — chosen at deployment, changed only with the human's yes.
# Read by the dark-factory plugin (guard.py on PreToolUse, quota.py) and scripts/merge-feature.sh.
# The file also opts the project in: without it the plugin's guards stay silent.
#
#   solo      the guard denies only destructive things: force push, a push to the main branch,
#             --no-verify/hooks bypass, release-tag pushes outside scripts/release.sh, deleting or
#             hard-resetting the main branch; --skip-ci allowed
#   standard  (default) solo + `gh pr merge` only via merge-feature.sh, no agent approvals,
#             the fence files are edited only with the human's yes in the permission dialog
#   team      standard + a GitHub approval (reviewDecision APPROVED) before merging; --skip-ci refused
#
# Human override of all fences: restart the session with GUARD=off (quota: QUOTA_GUARD=off).
FENCE_LEVEL=standard

# 1 = no quota data counts as "no new work" instead of letting work through (unattended sessions).
QUOTA_FAIL_CLOSED=0
