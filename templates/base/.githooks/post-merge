#!/usr/bin/env bash
# post-merge hook <project>
#
# Fires after `git merge` (including the merge phase of `git pull`). If the merged change
# touched .beads/issues.jsonl — auto `bd import` (beads sync via git JSONL, see .beads/README.md),
# to remove the manual step after every pull.
#
# Install: ./scripts/install-git-hooks.sh (core.hooksPath=.githooks — the hook updates itself with the repo).
# NON-fatal: an import failure does not break the merge.

set -uo pipefail

HOOK_DIR="$(dirname "$0")"

# ORIG_HEAD — the state before the merge; HEAD — after.
if git rev-parse -q --verify ORIG_HEAD >/dev/null 2>&1; then
    bash "${HOOK_DIR}/_bd-autoimport.sh" ORIG_HEAD HEAD || true
fi

exit 0
