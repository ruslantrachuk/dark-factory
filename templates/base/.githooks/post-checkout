#!/usr/bin/env bash
# post-checkout hook <project>
#
# Fires after `git checkout`/`git switch`. On a BRANCH change, if .beads/issues.jsonl
# differs between the old and the new HEAD — auto `bd import` (beads sync via git JSONL, see .beads/README.md).
#
# git arguments: $1 = prev HEAD, $2 = new HEAD, $3 = flag (1 = branch change, 0 = file checkout).
#
# Install: ./scripts/install-git-hooks.sh. NON-fatal: an import failure does not break the checkout.

set -uo pipefail

prev_head="${1:-}"
new_head="${2:-}"
branch_flag="${3:-0}"

# Only a branch change (not a single-file checkout) and an actual HEAD move.
if [ "${branch_flag}" != "1" ] || [ "${prev_head}" = "${new_head}" ]; then
    exit 0
fi

HOOK_DIR="$(dirname "$0")"
bash "${HOOK_DIR}/_bd-autoimport.sh" "${prev_head}" "${new_head}" || true

exit 0
